# game/story_scripts/script1.rpy:1310
translate english final_37eab93a:

    # p "Эй, я тебя понимаю, мой отец умер недавно, а мой брат не общается со мной."
    p "Hey, I understand you. My father passed away recently, and my brother doesn't talk to me."

# game/story_scripts/script1.rpy:1311
translate english final_20d6ae5e:

    # c "Ох..."
    c "Oh..."

# game/story_scripts/script1.rpy:1312
