    # t "Ну и как ты?"
    t "So, how are you holding up?"

# game/story_scripts/script1.rpy:1351
translate english final_fef9b3c6:

    # c "Вот, из больницы вышел."
    c "Just got out of the hospital."

# game/story_scripts/script1.rpy:1352
