    c "{font=MPLUSRounded1c-Black.ttf}おはよう…{/font}"

# game/story_scripts/script2.rpy:898
translate japanese day_in_miami_2_149e0c63:

    # fl "Доброе."
    fl "{font=MPLUSRounded1c-Black.ttf}おはよう。{/font}"

# game/story_scripts/script2.rpy:900
translate japanese day_in_miami_2_4488d68e:

    # c "Надо поговорить..."
    c "{font=MPLUSRounded1c-Black.ttf}話があるんだ…{/font}"

# game/story_scripts/script2.rpy:902
translate japanese day_in_miami_2_06ff39a6:

    # fl "Надо..."
    fl "{font=MPLUSRounded1c-Black.ttf}そうだな…{/font}"

# game/story_scripts/script2.rpy:904
translate japanese day_in_miami_2_8ba6011a:

    # c "Расскажите все что произошло."
    c "{font=MPLUSRounded1c-Black.ttf}起きたことを全部話してくれ。{/font}"

# game/story_scripts/script2.rpy:906
translate japanese day_in_miami_2_aa5c8e11:

    # fl "Дело было так...{w} Вы с Машей гуляли, и я проходил мимо. Решил познакомиться с вами. Мы искали парт-тайм для того чтобы выплатить лечение нашим родителям."
    fl "{font=MPLUSRounded1c-Black.ttf}事の始まりはこうだ…{w}お前とマーシャが散歩してて、通りかかった俺が声をかけた。親の治療費のためにアルバイトを探していたんだ。{/font}"

# game/story_scripts/script2.rpy:908
translate japanese day_in_miami_2_94f7fa32:

    # fl "Мы связались с старцом, как мы с ней узнали он Сэм Метти Старший. Он хотел убить нас и изнасиловать Машу."
    fl "{font=MPLUSRounded1c-Black.ttf}俺たちはあの老人と繋がった。後で分かったが、サム・メッティ・シニアという男だ。あいつは俺たちを殺し、マーシャを襲おうとした。{/font}"

# game/story_scripts/script2.rpy:910
translate japanese day_in_miami_2_f9bead70:

    # c "Мы его убили..."
    c "{font=MPLUSRounded1c-Black.ttf}俺たちが殺したのか…{/font}"

# game/story_scripts/script2.rpy:912
translate japanese day_in_miami_2_f043230c:

    # fl "Да, ты прав...{w} После этого Маша, того...{w} И ты попал в больницу, после твоего выхода ты год жил с отцом и переехал ко мне..."
    fl "{font=MPLUSRounded1c-Black.ttf}そうだ…{w}その後マーシャがあんなことになり…{w}お前は入院した。退院してから1年は父親と暮らし、それから俺のところへ来たんだ…{/font}"

# game/story_scripts/script2.rpy:914
translate japanese day_in_miami_2_68052e98:

    # fl "Мы спасли их, ну и дальше ты знаешь."
    fl "{font=MPLUSRounded1c-Black.ttf}二人を救い出して、あとは知っての通りさ。{/font}"

# game/story_scripts/script2.rpy:916
translate japanese day_in_miami_2_c690d06b:

    # c "Ужас..."
    c "{font=MPLUSRounded1c-Black.ttf}恐ろしいな…{/font}"

# game/story_scripts/script2.rpy:918
translate japanese day_in_miami_2_8d5ae7e6:

    # c "Но почему? Почему я ничего не знал о вас?"
    c "{font=MPLUSRounded1c-Black.ttf}でもどうして？どうして俺はお前たちのことを何も覚えていなかったんだ？{/font}"

# game/story_scripts/script2.rpy:920
translate japanese day_in_miami_2_c83760d8:

    # mol "После анонсирования диагноза, твое когнитивное восприятие изменилось."
    mol "{font=MPLUSRounded1c-Black.ttf}診断を受けた後、あなたの認知や知覚が変化してしまったの。{/font}"

# game/story_scripts/script2.rpy:923
translate japanese day_in_miami_2_af354fd3:

    # mol "Твой знакомый диагностировал у тебя ангедонию, меланхоличную депрессию и шизофрению..."
    mol "{font=MPLUSRounded1c-Black.ttf}あなたの知人は、アンヘドニア（快楽消失症）、メランコリー型うつ病、統合失調症と診断していた…{/font}"

# game/story_scripts/script2.rpy:925
translate japanese day_in_miami_2_a136566b:

    # mol "У меня было предположение, что у тебя шиза."
    mol "{font=MPLUSRounded1c-Black.ttf}統合失調症かもしれないと推測していたわ。{/font}"

# game/story_scripts/script2.rpy:926
translate japanese day_in_miami_2_b4d372ac:

    # mol "Может еще что-то."
    mol "{font=MPLUSRounded1c-Black.ttf}あるいは、他にも何か…{/font}"

# game/story_scripts/script2.rpy:928
translate japanese day_in_miami_2_bd2bee20:

    # mol "До выстрела в отца ты не с кем не говорил, только переписывался с [flinn_name] тоесть... с Флинном."
    mol "{font=MPLUSRounded1c-Black.ttf}父親を撃つ前まで、あなたは誰とも喋らず、ただ[flinn_name]…つまりフリンとだけメッセージのやり取りをしていたのよ。{/font}"

# game/story_scripts/script2.rpy:930
translate japanese day_in_miami_2_9b0702f7:

    # c "Я в шоке..."
    c "{font=MPLUSRounded1c-Black.ttf}ショックだ…{/font}"

# game/story_scripts/script2.rpy:932
translate japanese day_in_miami_2_e143cbc9:

    # mol "Мы приготовили яйца на всех, ты будешь?"
    mol "{font=MPLUSRounded1c-Black.ttf}みんなの分、卵料理を作ったんだけど食べる？{/font}"

# game/story_scripts/script2.rpy:936
translate japanese day_in_miami_2_23fcdd5b:

    # c "Да, почему бы и нет?"
    c "{font=MPLUSRounded1c-Black.ttf}ああ、頂こうかな。{/font}"

# game/story_scripts/script2.rpy:939
translate japanese day_in_miami_2_ac819e96:

    # c "Я пойду осмотрюсь в новом городе."
    c "{font=MPLUSRounded1c-Black.ttf}新しい街を見て回ってくるよ。{/font}"

# game/story_scripts/script2.rpy:940
translate japanese day_in_miami_2_97cffc49:

    # fl "Только не попадись!"
    fl "{font=MPLUSRounded1c-Black.ttf}警察には捕まるなよ！{/font}"

# game/story_scripts/script2.rpy:941
translate japanese day_in_miami_2_f0cc5bf3:

    # c "Ага."
    c "{font=MPLUSRounded1c-Black.ttf}ああ。{/font}"

# game/story_scripts/script2.rpy:950
translate japanese eat_eggs_6b0a0614:

    # mol "Давай, щас наложу."
    mol "{font=MPLUSRounded1c-Black.ttf}はい、今盛り付けるわね。{/font}"

# game/story_scripts/script2.rpy:952
translate japanese eat_eggs_1fb37c10:

    # c "Спасибо..."
    c "{font=MPLUSRounded1c-Black.ttf}ありがとう…{/font}"

# game/story_scripts/script2.rpy:958
translate japanese eat_eggs_1af8d80d:

    # "Я поел яйца."
    "{font=MPLUSRounded1c-Black.ttf}卵を食べた。{/font}"

# game/story_scripts/script2.rpy:964
translate japanese eat_eggs_ac819e96:

    # c "Я пойду осмотрюсь в новом городе."
    c "{font=MPLUSRounded1c-Black.ttf}新しい街を見て回ってくるよ。{/font}"

# game/story_scripts/script2.rpy:966
translate japanese eat_eggs_97cffc49:

    # fl "Только не попадись!"
    fl "{font=MPLUSRounded1c-Black.ttf}捕まるなよ！{/font}"

# game/story_scripts/script2.rpy:968
translate japanese eat_eggs_f0cc5bf3:

    # c "Ага."
    c "{font=MPLUSRounded1c-Black.ttf}ああ。{/font}"

# game/story_scripts/script2.rpy:976
translate japanese go_to_investigate_767ea9c2:

    # "Майами, неплохой город...{w} Интересно, он найдет нас?"
    "{font=MPLUSRounded1c-Black.ttf}マイアミ、悪くない街だ…{w}あいつは俺たちを見つけ出すだろうか？{/font}"

# game/story_scripts/script2.rpy:980
translate japanese go_to_investigate_57f9ae40:

    # "Я прошелся по улице."
    "{font=MPLUSRounded1c-Black.ttf}通りを歩いた。{/font}"

# game/story_scripts/script2.rpy:986
translate japanese go_to_investigate_b295fb8b:

    # "Я потерялся."
    "{font=MPLUSRounded1c-Black.ttf}道に迷ってしまった。{/font}"

# game/story_scripts/script2.rpy:988
translate japanese go_to_investigate_b0115fa9:

    # "О это что Молли?"
    "{font=MPLUSRounded1c-Black.ttf}おや、あれはモリーか？{/font}"

# game/story_scripts/script2.rpy:992
translate japanese go_to_investigate_d372f955:

    # c "Привет."
    c "{font=MPLUSRounded1c-Black.ttf}やあ。{/font}"

# game/story_scripts/script2.rpy:994
translate japanese go_to_investigate_6bd21b26:

    # mol "Привет."
    mol "{font=MPLUSRounded1c-Black.ttf}あら、やあ。{/font}"

# game/story_scripts/script2.rpy:996
translate japanese go_to_investigate_c818a092:

    # mol "Ты что тут делаешь?"
    mol "{font=MPLUSRounded1c-Black.ttf}ここで何してるの？{/font}"

# game/story_scripts/script2.rpy:998
translate japanese go_to_investigate_cccefa7f:

    # c "Гулял, знакомился с городом."
    c "{font=MPLUSRounded1c-Black.ttf}散歩して、街を散策してたんだ。{/font}"

# game/story_scripts/script2.rpy:1000
translate japanese go_to_investigate_d7786641:

    # mol "Ааа, я поняла. Ну тут красиво, если ты хотел это понять."
    mol "{font=MPLUSRounded1c-Black.ttf}そうだったのね。ここは綺麗でしょう？{/font}"

# game/story_scripts/script2.rpy:1002
translate japanese go_to_investigate_2321a340:

    # c "Ну, я понимаю."
    c "{font=MPLUSRounded1c-Black.ttf}まあ、分かるよ。{/font}"

# game/story_scripts/script2.rpy:1006
translate japanese go_to_investigate_f3389017:

    # mol "Расскажи про себя."
    mol "{font=MPLUSRounded1c-Black.ttf}あなたのこと、教えて。{/font}"

# game/story_scripts/script2.rpy:1008
translate japanese go_to_investigate_0bd200af:

    # c "Ну...{w} Вы и так знаете, моя мать болела, я впал в лютую депрессию."
    c "{font=MPLUSRounded1c-Black.ttf}うーん…{w}もう知ってるだろ。母さんが病気になって、ひどい鬱に陥ったんだ。{/font}"

# game/story_scripts/script2.rpy:1010
translate japanese go_to_investigate_fccc444b:

    # mol "Я слышала, ты убил человека, так ли это?"
    mol "{font=MPLUSRounded1c-Black.ttf}聞いたわ、人を殺したって…本当なの？{/font}"

# game/story_scripts/script2.rpy:1014
translate japanese go_to_investigate_f27ad6d3:

    # "Я признался Молли, я чувствую ее доверие."
    "{font=MPLUSRounded1c-Black.ttf}俺はモリーに打ち明けた。彼女への信頼を感じていた。{/font}"

# game/story_scripts/script2.rpy:1021
translate japanese molli_kambo_talk_e99ed033:

    # mol "Ну, я поняла."
    mol "{font=MPLUSRounded1c-Black.ttf}そう、分かったわ。{/font}"

# game/story_scripts/script2.rpy:1023
translate japanese molli_kambo_talk_b6bd0848:

    # c "А вы, расскажите про себя."
    c "{font=MPLUSRounded1c-Black.ttf}今度は君の番だ、教えてくれ。{/font}"

# game/story_scripts/script2.rpy:1025
translate japanese molli_kambo_talk_7c3d095a:

    # mol "О...{w} Ну мне нечего особо говорить."
    mol "{font=MPLUSRounded1c-Black.ttf}えっ…{w}特別話すようなことはないわよ。{/font}"

# game/story_scripts/script2.rpy:1027
translate japanese molli_kambo_talk_abf3949f:

    # mol "Я родилась в Америке, и переехала жить в Россию, заинтересовала аура России."
    mol "{font=MPLUSRounded1c-Black.ttf}アメリカで生まれて、ロシアの雰囲気に惹かれて移住したの。{/font}"

# game/story_scripts/script2.rpy:1029
translate japanese molli_kambo_talk_71b07a5c:

    # c "Хах, скажу так - в России ловить нечего."
    c "{font=MPLUSRounded1c-Black.ttf}ハッ、言っとくがロシアに良いことなんて何もないぞ。{/font}"

# game/story_scripts/script2.rpy:1031
translate japanese molli_kambo_talk_e81d10af:

    # mol "Это я уже поняла."
    mol "{font=MPLUSRounded1c-Black.ttf}それはもう痛感したわ。{/font}"

# game/story_scripts/script2.rpy:1033
translate japanese molli_kambo_talk_a03ea2ab:

    # c "А что дальше?"
    c "{font=MPLUSRounded1c-Black.ttf}それからどうした？{/font}"

# game/story_scripts/script2.rpy:1035
translate japanese molli_kambo_talk_2aa3abc1:

    # mol "Ну после, я приехала в какой-то бар."
    mol "{font=MPLUSRounded1c-Black.ttf}それから、とあるバーに行ったの。{/font}"

# game/story_scripts/script2.rpy:1037
translate japanese molli_kambo_talk_145933fd:

    # mol "Встретила твоего отца. Мне стало его жалко, я дала ему визитку."
    mol "{font=MPLUSRounded1c-Black.ttf}あなたのお父さんに会って、気の毒に思って名刺を渡したの。{/font}"

# game/story_scripts/script2.rpy:1039
translate japanese molli_kambo_talk_b3c71028:

    # mol "В момент смерти твоей матери, он мне позвонил, я приехала, ну...{w} Ты понимаешь что дальше случилось..."
    mol "{font=MPLUSRounded1c-Black.ttf}お母さんが亡くなった時、彼から電話があって駆けつけたわ…それで…{w}そのあとどうなったかは察がつくでしょう…{/font}"

# game/story_scripts/script2.rpy:1043
translate japanese molli_kambo_talk_3977fb9d:

    # mol "Ну..."
    mol "{font=MPLUSRounded1c-Black.ttf}ええと…{/font}"

# game/story_scripts/script2.rpy:1046
translate japanese molli_kambo_talk_301c8ef7:

    # mol "..."
    mol "{font=MPLUSRounded1c-Black.ttf}…{/font}"

# game/story_scripts/script2.rpy:1047
translate japanese molli_kambo_talk_203ae887:

    # "Кажется Молли покраснела."
    "{font=MPLUSRounded1c-Black.ttf}モリーが赤くなったようだ。{/font}"

# game/story_scripts/script2.rpy:1052
translate japanese back_to_home_c4677afc:

    # mol "Впрочем, не будем об этом."
    mol "{font=MPLUSRounded1c-Black.ttf}とにかく、この話はやめましょう。{/font}"

# game/story_scripts/script2.rpy:1054
translate japanese back_to_home_db116684:

    # mol "Пошли домой, а то начинает темнеть..."
    mol "{font=MPLUSRounded1c-Black.ttf}暗くなってきたから家に帰りましょう…{/font}"

# game/story_scripts/script2.rpy:1060
translate japanese back_to_home_565175b9:

    # "Вы отправились с Молли домой."
    "{font=MPLUSRounded1c-Black.ttf}モリーと一緒に帰路についた。{/font}"

# game/story_scripts/script2.rpy:1066
translate japanese back_to_home_3dfa66ba:

    # "Вы пришли и легли спать."
    "{font=MPLUSRounded1c-Black.ttf}帰宅して横になった。{/font}"

# game/story_scripts/script2.rpy:1074
translate japanese third_day_in_miami_ea6f2547:

    # "Хмм, что бы сегодня поделать..."
    "{font=MPLUSRounded1c-Black.ttf}ふむ、今日は何をしようか…{/font}"

# game/story_scripts/script2.rpy:1078
translate japanese third_day_in_miami_913687b9:

    # "Полагаю нечего."
    "{font=MPLUSRounded1c-Black.ttf}特に何もないな。{/font}"

# game/story_scripts/script2.rpy:1080
translate japanese third_day_in_miami_2037933a:

    # "Тогда пойду на балкон, послушаю музыку."
    "{font=MPLUSRounded1c-Black.ttf}じゃあバルコニーに行って音楽でも聴こう。{/font}"

# game/story_scripts/script2.rpy:1084
translate japanese third_day_in_miami_6a6ef16a:

    # "Какую бы песню выбрать?"
    "{font=MPLUSRounded1c-Black.ttf}どの曲を選ぼうか？{/font}"

# game/story_scripts/script2.rpy:1088
translate japanese third_day_in_miami_2d9ba383:

    # "Да, то что нужно. послушаю и позалипаю в теле"
    "{font=MPLUSRounded1c-Black.ttf}よし、これだ。音楽を聴きながらスマホでもいじるか。{/font}"

# game/story_scripts/script2.rpy:1089
translate japanese third_day_in_miami_01b95f81:

    # "А точно у меня же только плеер остался..."
    "{font=MPLUSRounded1c-Black.ttf}あ、そうだ、プレーヤーしか残ってないんだった…{/font}"

# game/story_scripts/script2.rpy:1090
translate japanese third_day_in_miami_368d417a:

    # "Ну тогда просто посмотрю на вида"
    "{font=MPLUSRounded1c-Black.ttf}じゃあ景色を眺めるだけにするか。{/font}"

# game/story_scripts/script2.rpy:1095
translate japanese third_day_in_miami_52289489:

    # "Ну... {p} Неплохо!"
    "{font=MPLUSRounded1c-Black.ttf}ふむ… {p} 悪くないね！{/font}"

# game/story_scripts/script2.rpy:1096
translate japanese third_day_in_miami_e22e7b95:

    # "Полюбуюсь на виды!"
    "{font=MPLUSRounded1c-Black.ttf}景色を楽しもう！{/font}"

# game/story_scripts/script2.rpy:1101
translate japanese third_day_in_miami_a20cefa7:

    # "..."
    "{font=MPLUSRounded1c-Black.ttf}…{/font}"

# game/story_scripts/script2.rpy:1144
translate japanese after_songs_f964c0b0:

    # "Это было странно!"
    "{font=MPLUSRounded1c-Black.ttf}奇妙だったな！{/font}"

# game/story_scripts/script2.rpy:1147
translate japanese after_songs_aa2513e4:

    # "Норм."
    "{font=MPLUSRounded1c-Black.ttf}まあまあだな。{/font}"

# game/story_scripts/script2.rpy:1150
translate japanese after_songs_ffe0e351:

    # "Где-то я это уже слышал..."
    "{font=MPLUSRounded1c-Black.ttf}どこかで聴いたことがあるような…{/font}"

# game/story_scripts/script2.rpy:1153
translate japanese after_songs_a6aa5c85:

    # "Я решил не слушать."
    "{font=MPLUSRounded1c-Black.ttf}聴かないことにした。{/font}"

# game/story_scripts/script2.rpy:1155
translate japanese after_songs_bfab4a30:

    # "Ну ладно пойду, посмотрю как они..."
    "{font=MPLUSRounded1c-Black.ttf}さて、あいつらの様子でも見に行くか…{/font}"

# game/story_scripts/script2.rpy:1161
translate japanese after_songs_ccfe8e6e:

    # fl "..."
    fl "{font=MPLUSRounded1c-Black.ttf}…{/font}"

# game/story_scripts/script2.rpy:1163
translate japanese after_songs_ee3efd4b:

    # c "А где она?"
    c "{font=MPLUSRounded1c-Black.ttf}彼女はどこへ行った？{/font}"

# game/story_scripts/script2.rpy:1165
translate japanese after_songs_1f366da9:

    # fl "Ушла куда-то..."
    fl "{font=MPLUSRounded1c-Black.ttf}どこかへ出かけたよ…{/font}"

# game/story_scripts/script2.rpy:1169
translate japanese after_songs_d19f855d:

    # c "..."
    c "{font=MPLUSRounded1c-Black.ttf}…{/font}"

# game/story_scripts/script2.rpy:1173
translate japanese after_songs_ccfe8e6e_1:

    # fl "..."
    fl "{font=MPLUSRounded1c-Black.ttf}…{/font}"

# game/story_scripts/script2.rpy:1175
translate japanese after_songs_844c8f62:

    # c "Не расскажешь как вы меня пронесли?"
    c "{font=MPLUSRounded1c-Black.ttf}どうやって俺を連れ出したのか教えてくれないか？{/font}"

# game/story_scripts/script2.rpy:1177
translate japanese after_songs_9d40db87:

    # fl "Дело было так..."
    fl "{font=MPLUSRounded1c-Black.ttf}実はこうなんだ…{/font}"

# game/story_scripts/script2.rpy:1183
translate japanese after_songs_5d4c98a8:

    # fl "ВЫРЕЖ ПОЖАЛУЙСТА ПАШ!"
    fl "{font=MPLUSRounded1c-Black.ttf}パシャ、頼むからカットしてくれ！{/font}"

