    fl "僕たち、もう終わりだ…"

# game/story_scripts/script1.rpy:752
translate japanese day_3_b454588b:

    # c "Чувак, на что ты нас подписал?"
    c "おい、俺たちをどんなトラブルに巻き込んだんだ！？"

# game/story_scripts/script1.rpy:754
translate japanese day_3_cb1cb140:

    # fl "Я не знал!"
    fl "僕だって知らなかったんだよ！"

# game/story_scripts/script1.rpy:756
translate japanese day_3_0dc06cca:

    # c "Ну будем сидеть, ждать счастливого момента."
    c "ハッ、じっと待って助けWaitでも待つしかないか。"

# game/story_scripts/script1.rpy:768
translate japanese day_3_139956e4:

    # c "Чувак! Тут монтировка."
    c "おい！ バールがあったぞ！"

# game/story_scripts/script1.rpy:770
translate japanese day_3_90b927a6:

    # fl "Ооо, давай, ломай эту дверь."
    fl "よし！ それでドアをこじ開けてくれ！"

# game/story_scripts/script1.rpy:778
translate japanese day_3_05453fd1:

    # c "Где Маша?"
    c "マーシャはどこだ！？"

# game/story_scripts/script1.rpy:780
translate japanese day_3_acda1141:

    # c "Она внутри амбара, погнали посмотрим!"
    c "納屋の中にいるはずだ、行ってみよう！"

# game/story_scripts/script1.rpy:793
translate japanese day_3_bf843c7c:

    # c "Маша."
    c "マーシャ！"

# game/story_scripts/script1.rpy:795
translate japanese day_3_3ed81cb4:

    # m "О-он."
    m "あ… あの男が…"

# game/story_scripts/script1.rpy:797
translate japanese day_3_298691cc:

    # fl "Успокойся, что он сделал?"
    fl "落ち着いて、奴が何をしたんだ？"

# game/story_scripts/script1.rpy:799
translate japanese day_3_95ec74b8:

    # m "Он он он."
    m "あいつ… あいつが…"

# game/story_scripts/script1.rpy:801
translate japanese day_3_401c1d04:

    # m "Он изнасиловал меня."
    m "私を… 乱暴したの…"

# game/story_scripts/script1.rpy:803
translate japanese day_3_4851bb97:

    # c "Тихо сестренка, успокойся."
    c "落ち着けマーシャ、大丈夫だ。"

# game/story_scripts/script1.rpy:805
translate japanese day_3_e4de9d6a:

    # c "Мне нужно отойти, ты должна быть сильной, понимаешь?"
    c "俺はちょっと外に出る。お前は強くならなきゃいけない、わかるな？"

# game/story_scripts/script1.rpy:807
translate japanese day_3_e612037c:

    # m "..."
    m "…"

# game/story_scripts/script1.rpy:813
translate japanese day_3_c6f96b02:

    # c "Ох, я освежую этого выродка и пожарю его на костре, и съем каждую крупинку его подкожного жира."
    c "あのクソ野郎 paidの皮を剥いで、焚き火で炙って、皮下脂肪の一粒まで喰らい尽くしてやる。"

# game/story_scripts/script1.rpy:815
translate japanese day_3_2c04b4fa:

    # c "Этот ублюдок пожалеет, что не убил нас, Флинн ты со мной?"
    c "俺たちを生かしたことを後悔させてやる。フリン、ついてくるか？"

# game/story_scripts/script1.rpy:817
translate japanese day_3_39f24773:

    # fl "Я с тобой, не важно куда."
    fl "ああ、どこまでも一緒に行くよ。"

# game/story_scripts/script1.rpy:827
translate japanese day_3_a57d1a2b:

    # o "Ну привет, как вам?"
    o "やあ、気分はどうかな？"

# game/story_scripts/script1.rpy:829
translate japanese day_3_d405194e:

    # c "Ты кусок дерьма! Какого хера ты творишь?"
    c "このクソ野郎！ 一体何のつもりだ！"

# game/story_scripts/script1.rpy:831
translate japanese day_3_fcde7e5c:

    # o "Да потому что человечество сгнило!"
    o "人間という種族が腐りきっているからだ！"

# game/story_scripts/script1.rpy:833
translate japanese day_3_01c1810e:

    # o "Это они заставили меня это делать!"
    o "連中が私にこんなことを強いたのだ！"

# game/story_scripts/script1.rpy:835
translate japanese day_3_d1a91e06:

    # o "Мы с сыном всегда были против насилия!"
    o "私と息子は、いつだって暴力に反対してきた！"

# game/story_scripts/script1.rpy:837
translate japanese day_3_eacf20ad:

    # c "Это сука не отговорка, давай я блять твоего сына выебу, а потом убью его?"
    c "言い訳してんじゃねえぞクソが！ じゃあ俺がお前の息子を犯して殺してもいいんだな！？"

# game/story_scripts/script1.rpy:839
translate japanese day_3_08705770:

    # o "Ты че сука блять! Он не смоет позор, а твоя сестра - позорный кусок дерьма, которая через пару лет сама бы стала давалкой!"
    o "ふざけるな！ 息子は屈辱に耐えられん！ だがお前の妹はどうだ？ 数年も経てば誰に bootでも股を開くようなビッチになる運命だったんだ！"

# game/story_scripts/script1.rpy:841
translate japanese day_3_b586e290:

    # c "Ты мразь, нихуя не разбираешься в женской психологии, я не удивлен, что у тебя жены нет!"
    c "ゲス野郎が、女の気持ちなんてこれっぽっちも分かってない癖に！ 妻に捨てられたのも納得だわ！"

# game/story_scripts/script1.rpy:843
translate japanese day_3_7d7b6b68:

    # o "Да ты сука не понимаешь блять! Семья это главное!"
    o "貴様には分からんのだ！ 家族こそが全てなのだ！"

# game/story_scripts/script1.rpy:845
translate japanese day_3_cc6ca97d:

    # c "Ты прав сука! Эй, пора с этим кончать."
    c "ああそうだぜクソ野郎！ おい、決着をつけようぜ。"

# game/story_scripts/script1.rpy:851
translate japanese day_3_f791dfb4:

    # o "Ай блять...!"
    o "ぐあああっ…！"

# game/story_scripts/script1.rpy:855
translate japanese day_3_d0a5a644:

    # o "Сукааа!"
    o "くそがあああ！"

# game/story_scripts/script1.rpy:859
translate japanese day_3_d8542e22:

    # c "Ты мразь, я убью тебя!"
    c "このゲス野郎、ぶっ殺してやる！"

# game/story_scripts/script1.rpy:873
translate japanese day_3_53df3a87:

    # o "{cps=100} Я тебя блять, аааа...{nw}{/cps}"
    o "{cps=100}お前を、殺… ああああ…{nw}{/cps}"

# game/story_scripts/script1.rpy:875
translate japanese day_3_c2d0e8d5:

    # c "На сука!"
    c "くらえクソ野郎！"

# game/story_scripts/script1.rpy:887
translate japanese day_3_03625b52:

    # extend " Н-на мразь!"
    extend " 死ね、クズが！"

# game/story_scripts/script1.rpy:898
translate japanese day_3_437f97fe:

    # extend " Я тебя ненавижу!!!"
    extend " 大嫌いだ！！！"

# game/story_scripts/script1.rpy:910
translate japanese day_3_bca7ecd3:

    # c "СУКА."
    c "くそっ。"

# game/story_scripts/script1.rpy:912
translate japanese day_3_9f2ff81e:

    # c "Мы должны уходить."
    c "ここを出ないと。"

# game/story_scripts/script1.rpy:914
translate japanese day_3_be3668c3:

    # c "Маша!"
    c "マーシャ！"

# game/story_scripts/script1.rpy:916
translate japanese day_3_b6998d19:

    # m "Д-да."
    m "あ… うん。"

# game/story_scripts/script1.rpy:918
translate japanese day_3_cc874425:

    # c "Эй Флинн, поможешь с трупом?"
    c "おいフリン、死体を運ぶのを手伝ってくれ。"

# game/story_scripts/script1.rpy:920
translate japanese day_3_9ad2baac:

    # fl "Чувак, ты ебанутый."
    fl "お前、狂ってるよ。"

# game/story_scripts/script1.rpy:938
translate japanese pizdec_a20cefa7:

    # "..."
    "…"

# game/story_scripts/script1.rpy:940
translate japanese pizdec_eb87272e:

    # c "Нихера, смотри - сумка с деньгами. Мы можем попробовать оплатить лечение родителям."
    c "おい見ろよ、金の入ったバッグだ。これで親たちの治療費が払えるかもしれない。"

# game/story_scripts/script1.rpy:942
translate japanese pizdec_7f8d3d65:

    # fl "Ооо бери."
    fl "うわ、持っていこう。"

# game/story_scripts/script1.rpy:944
translate japanese pizdec_e353aaeb:

    # c "Никому не говорите!"
    c "誰にも言うなよ！"

# game/story_scripts/script1.rpy:946
translate japanese pizdec_07621a79:

    # fl "Чувак..."
    fl "おいおい…"

# game/story_scripts/script1.rpy:948
translate japanese pizdec_38259697:

    # c "Заткнись... Тоесть прости... Я не хотел."
    c "黙れ… いや、ごめん… 責めるつもりじゃなかったんだ。"

# game/story_scripts/script1.rpy:950
translate japanese pizdec_ba038326:

    # fl "Ладно, не время разглагольствовать."
    fl "わかってる。無駄話をしてる場合じゃない。"

# game/story_scripts/script1.rpy:952
translate japanese pizdec_69f4cba4:

    # c "Ты прав... Машу совсем парализовало."
    c "その通りだ… マーシャがショックで動けないんだ。"

# game/story_scripts/script1.rpy:960
translate japanese pizdec_5155774e:

    # c "Маш?"
    c "マーシャ？"

# game/story_scripts/script1.rpy:962
translate japanese pizdec_fa915d03:

    # m "П-пошли домой, пожалуйста..."
    m "お、お願い… 家に帰りたい…"

# game/story_scripts/script1.rpy:964
translate japanese pizdec_81c09fa6:

    # c "Гребанный старик совсем изжил своё и ебнулся...?"
    c "あのクソジジイ、ボケて頭がおかしくなってたのか…？"

# game/story_scripts/script1.rpy:966
translate japanese pizdec_c2e95374:

    # fl "Пошли."
    fl "行こう。"

# game/story_scripts/script1.rpy:970
translate japanese pizdec_0d33fd50:

    # "Папа уехал в больницу к маме."
    "親父はお袋の病院へ行った。"

# game/story_scripts/script1.rpy:974
translate japanese pizdec_a4a59afe:

    # "Нужно ее уложить."
    "マーシャを寝かせないと。"

# game/story_scripts/script1.rpy:976
translate japanese pizdec_0afb30f0:

    # c "Маш, пошли."
    c "マーシャ、おいで。"

# game/story_scripts/script1.rpy:978
translate japanese pizdec_43e85078:

    # m "Д-давай..."
    m "うん…"

# game/story_scripts/script1.rpy:984
translate japanese pizdec_e6de2c81:

    # "Ну ладно я спать пойду."
    "よし、俺も寝よう。"

# game/story_scripts/script1.rpy:986
translate japanese pizdec_ab0131fe:

    # m "Спокойной ночи. Я люблю тебя."
    m "おやすみ。大好きだよ。"

# game/story_scripts/script1.rpy:988
translate japanese pizdec_6f35d89a:

    # c "Я тоже..."
    c "俺もだよ…"

# game/story_scripts/script1.rpy:992
translate japanese pizdec_f5265df7:

    # "Л-ладно я пойду спать."
    "い、よし、寝るか。"

# game/story_scripts/script1.rpy:1000
translate japanese final_026a88a4:

    # "Уже утро."
    "もう朝だ。"

# game/story_scripts/script1.rpy:1002
translate japanese final_99af0c36:

    # "Пойду в школу."
    "学校に行こう。"

# game/story_scripts/script1.rpy:1008
translate japanese final_a72e844e:

    # "Странно, Маша уже должна была выйти."
    "おかしいな、マーシャはもう部屋を出ているはずなのに。"

# game/story_scripts/script1.rpy:1022
translate japanese final_6d7aeef7:

    # nvl clear
    # fl_nvl "Эй? Камбо? Жив?"
    nvl clear
    fl_nvl "おい、カンボ？ 生きてる？"

# game/story_scripts/script1.rpy:1026
translate japanese final_8c27066a:

    # c_nvl "Да."
    c_nvl "ああ。"

# game/story_scripts/script1.rpy:1028
translate japanese final_e9fee381:

    # fl_nvl "Как Маша?"
    fl_nvl "マーシャの様子は？"

# game/story_scripts/script1.rpy:1030
translate japanese final_6670a33e:

    # c_nvl "Странно, она должна была пойти в школу."
    c_nvl "変なんだ、学校に行く時間なのに。"

# game/story_scripts/script1.rpy:1032
translate japanese final_f3d59b0a:

    # c_nvl "Но ее нет."
    c_nvl "姿が見えない。"

# game/story_scripts/script1.rpy:1034
translate japanese final_ab713f77:

    # fl_nvl "Может она спит?"
    fl_nvl "まだ寝てるんじゃない？"

# game/story_scripts/script1.rpy:1036
translate japanese final_be9e1aa2:

    # c_nvl "Скорее всего. Пойду проверю ее."
    c_nvl "多分ね。ちょっと部屋を見てくる。"

# game/story_scripts/script1.rpy:1052
translate japanese final_b368f13e:

    # c "М-мааааш?..."
    c "マ… マーシャ…？"

# game/story_scripts/script1.rpy:1054
translate japanese final_d19f855d:

    # c "..."
    c "…"

# game/story_scripts/script1.rpy:1056
translate japanese final_3ff0e8c5:

    # "Она дышит?"
    "息をしてるのか…？"

# game/story_scripts/script1.rpy:1058
translate japanese final_5155774e:

    # c "Маш?"
    c "マーシャ？"

# game/story_scripts/script1.rpy:1087
translate japanese final_745361e8:

    # c "Твою мать, что это? Бисопролол? Пустой блистер."
    c "くそっ、これは何だ？ ビソプロロール？ 空のシート…"

# game/story_scripts/script1.rpy:1089
translate japanese final_e1984d46:

    # c "Стой НЕЕЕЕЕЕТ..."
    c "おい待て、嘘だろおおお…"

# game/story_scripts/script1.rpy:1091
translate japanese final_f6aec01c:

    # c "Зачем? Зачем? Мы же почти победили? СУУУУУУУУУУКАААААААА ЕБАНЫЙ ДЕЕЕЕЕД."
    c "なんでだよ！？ なんで！？ あと少しで救えたのに！ くそがああああ！ あのクソジジイのせいでぇぇぇ！"

# game/story_scripts/script1.rpy:1093
translate japanese final_ffbc8a0d:

    # c "Мааааша пожалуйста. Блять надо бежать в больницу."
    c "マーシャ、頼むから目を開けてくれ。くそっ、病院に運ばないと！"

# game/story_scripts/script1.rpy:1095
translate japanese final_ca6fbd9c:

    # c "Алло это такси? Я живу в..."
    c "もしもし、タクシーですか！？ 今すぐ来てくれ、場所は…"

# game/story_scripts/script1.rpy:1103
translate japanese final_a7ad9de7:

    # c "Здравствуйте мне в городскую больницу."
    c "すみません、市立病院までお願いします！"

# game/story_scripts/script1.rpy:1105
translate japanese final_22284835:

    # t "Здравствуйте. Самая близкая к нам в Орехово-Зуево."
    t "乗ってください。一番近いのはオレホヴォ＝ズエヴォの病院ですね。"

# game/story_scripts/script1.rpy:1107
translate japanese final_d38f9e7a:

    # c "Едьте, только быстрее!"
    c "急いで出してください！"

# game/story_scripts/script1.rpy:1113
translate japanese final_8b6f19eb:

    # t "Мы приехали."
    t "到着しましたよ。"

# game/story_scripts/script1.rpy:1115
translate japanese final_5e0884b1:

    # c "Спасибо, вот вам."
    c "ありがとうございます、釣りはいりません！"

# game/story_scripts/script1.rpy:1117
translate japanese final_6b913947:

    # t "До свидания, удачи вам."
    t "お気をつけて。"

# game/story_scripts/script1.rpy:1123
translate japanese final_881276ee:

    # c "ПОМОГИ..."
    c "助け… て…"

# game/story_scripts/script1.rpy:1135
translate japanese final_7411fa81:

    # "Аййй голова..."
    "うっ… 頭が…"

# game/story_scripts/script1.rpy:1137
translate japanese final_826974fe:

    # "Стоп, где Маша?"
    "待て、マーシャはどこだ！？"

# game/story_scripts/script1.rpy:1139
translate japanese final_16bcf0ae:

    # med "Привет, ты после операции, как ты?"
    med "やあ、手術が終わったばかりだよ。気分はどうだい？"

# game/story_scripts/script1.rpy:1141
translate japanese final_7208b4d5:

    # c "Чего? Какая операция?"
    c "え？ 手術って何のことだ？"

# game/story_scripts/script1.rpy:1143
translate japanese final_1a63988b:

    # med "У вас нож застрял в спине. Ты чуть не умер... Радуйся."
    med "背中にナイフが刺さっていたんだ。命が助かっただけでも儲けものだよ。"

# game/story_scripts/script1.rpy:1145
translate japanese final_109d57e5:

    # c "Твою мать, какой нож?"
    c "くそっ、ナイフだって…！？"

# game/story_scripts/script1.rpy:1147
translate japanese final_d96c4d5f:

    # med "Я и пришел спросить. Нам пришлось делать операцию незаконно, или ты бы умер..."
    med "事情を聞きたくてね。緊急処置をしなかったら、君は死んでいた。"

# game/story_scripts/script1.rpy:1149
translate japanese final_62d1e146:

    # med "Как вас зовут?"
    med "君のお名前は？"

# game/story_scripts/script1.rpy:1151
translate japanese final_e91cffeb:

    # c "Камбо."
    c "カンボです。"

# game/story_scripts/script1.rpy:1153
translate japanese final_ed4219f0:

    # med "Очень странное имя."
    med "変わった名前だね。"

# game/story_scripts/script1.rpy:1155
translate japanese final_4370926d:

    # med "А та девушка, кхм, которая была с вами...\nЯ соболезную, она умерла от остановки сердца.\nВ крови нашли передоз сердечными лекарствами, вы что-то знаете?"
    med "それと、一緒に運ばれてきた女の子だが…\n気の毒だが、心停止で亡くなったよ。\n心臓薬の過剰摂取が検出された。心当たりはあるかい？"

# game/story_scripts/script1.rpy:1157
translate japanese final_e39a8063:

    # c "М-маша..."
    c "マ… マーシャ…"

# game/story_scripts/script1.rpy:1159
translate japanese final_f42eed8d:

    # med "Ее имя Маша. Соболезную, друг."
    med "マーシャちゃんというのか。お悔やみ申し上げるよ。"

# game/story_scripts/script1.rpy:1161
translate japanese final_f105355c:

    # med "Так расскажешь, что произошло?"
    med "何があったのか、話してくれるかい？"

# game/story_scripts/script1.rpy:1163
translate japanese final_4f31e7e6:

    # c "Я проснулся, пошел в школу, хотел с ней встретиться как обычно, но она опоздала уже на час."
    c "朝起きて学校に行って、いつものように合流するはずだったのに、彼女が1時間以上遅刻してて。"

# game/story_scripts/script1.rpy:1165
translate japanese final_4dbc8bde:

    # c "Я пришел проведать ее, но она лежала в кровати, а рядом с ней был пустой блистер с бисопрололом."
    c "心配になって家に戻ったら、ベッドで倒れていて… 脇にビソプロロールの空のシートが落ちていたんです。"

# game/story_scripts/script1.rpy:1167
