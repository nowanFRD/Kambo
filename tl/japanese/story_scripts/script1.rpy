    # med "Марков Камбо Петрович, хм, у вас есть паспорт?"
    med "{font=MPLUSRounded1c-Black.ttf}マルコフ・カンボ・ペトロヴィチね。身分証はあるかい？{/font}"

# game/story_scripts/script1.rpy:1177
