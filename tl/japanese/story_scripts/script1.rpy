    # c "Да, возьмите."
    c "{font=MPLUSRounded1c-Black.ttf}はい、どうぞ。{/font}"

# game/story_scripts/script1.rpy:1181
translate japanese final_b7606cd1:

    # med "Угу."
    med "{font=MPLUSRounded1c-Black.ttf}よし。{/font}"

# game/story_scripts/script1.rpy:1183
